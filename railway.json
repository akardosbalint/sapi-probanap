{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd salesautopilot-meeting-agent && npm install"
  },
  "deploy": {
    "startCommand": "cd salesautopilot-meeting-agent && node index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

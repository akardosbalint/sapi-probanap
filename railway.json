{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "meeting-agent": {
      "build": {
        "builder": "NIXPACKS",
        "nixpacksConfigPath": "salesautopilot-meeting-agent/nixpacks.toml"
      },
      "deploy": {
        "startCommand": "node salesautopilot-meeting-agent/index.js",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      }
    }
  }
}

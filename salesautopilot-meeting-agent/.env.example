# ── Kötelező ────────────────────────────────────────────────
# Anthropic API kulcs – https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Make.com webhook URL – a feldolgozás utáni következő scenario indítójához
# Make.com → Create a webhook → másold be az URL-t
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Opcionális ──────────────────────────────────────────────
# Szerver port (Railway/Render automatikusan felülírja)
PORT=3000
